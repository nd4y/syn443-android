+package http2
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"testing"
+)
+
+type uncomparableRetryContext struct {
+	context.Context
+	values []string
+}
+
+// The outer type is comparable, but comparing its interface field can still
+// panic. Testing only reflect.Type.Comparable is insufficient.
+type wrappedRetryContext struct{ context.Context }
+
+func TestRetryDialWithUncomparableContexts(t *testing.T) {
+	canceled, cancel := context.WithCancel(context.Background())
+	cancel()
+	dead := uncomparableRetryContext{Context: canceled}
+	live := uncomparableRetryContext{Context: context.Background()}
+	for _, test := range []struct {
+		name          string
+		call, request context.Context
+		err           error
+		want          bool
+	}{
+		{"same-canceled-value", dead, dead, context.Canceled, false},
+		{"another-live-value", dead, live, context.Canceled, true},
+		{"nested-interface-values", wrappedRetryContext{dead}, wrappedRetryContext{live}, context.Canceled, true},
+		{"without-cancel-values", context.WithoutCancel(dead), context.WithoutCancel(live), context.Canceled, false},
+		{"canceled-caller", dead, dead, context.DeadlineExceeded, false},
+		{"live-dial-context", live, live, context.Canceled, false},
+		{"network-error", dead, live, errors.New("permanent failure"), false},
+		{"success", dead, live, nil, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			req, err := http.NewRequestWithContext(test.request, "GET", "https://example.test", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := shouldRetryDial(&dialCall{ctx: test.call, err: test.err}, req); got != test.want {
+				t.Fatalf("retry = %v, want %v", got, test.want)
+			}
+		})
+	}
+}
