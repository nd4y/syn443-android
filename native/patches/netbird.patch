index 0000000..a02d152
--- /dev/null
+++ b/client/embed/diagnostics.go
@@ -0,0 +1,128 @@
+package embed
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/binary"
+	"errors"
+	"net"
+	"sort"
+	"time"
+
+	"github.com/netbirdio/netbird/client/internal/stdnet"
+	"golang.org/x/net/icmp"
+	"golang.org/x/net/ipv4"
+)
+
+// ConnectionSnapshot is a cheap recorder snapshot. Unlike Status it never runs
+// health probes and never exports keys, credentials or endpoint addresses.
+type ConnectionSnapshot struct {
+	ManagementConnected bool           `json:"management_connected"`
+	SignalConnected     bool           `json:"signal_connected"`
+	IP                  string         `json:"ip"`
+	FQDN                string         `json:"fqdn"`
+	Peers               []PeerSnapshot `json:"peers"`
+}
+type PeerSnapshot struct {
+	IP            string    `json:"ip"`
+	FQDN          string    `json:"fqdn"`
+	State         string    `json:"state"`
+	Relayed       bool      `json:"relayed"`
+	LastHandshake time.Time `json:"last_handshake"`
+	BytesTx       int64     `json:"bytes_tx"`
+	BytesRx       int64     `json:"bytes_rx"`
+}
+
+func (c *Client) ConnectionSnapshot() ConnectionSnapshot {
+	_ = c.recorder.RefreshWireGuardStats()
+	s := c.recorder.GetFullStatus()
+	result := ConnectionSnapshot{ManagementConnected: s.ManagementState.Connected, SignalConnected: s.SignalState.Connected,
+		IP: s.LocalPeerState.IP, FQDN: s.LocalPeerState.FQDN, Peers: make([]PeerSnapshot, 0, len(s.Peers))}
+	for _, p := range s.Peers {
+		state := "disconnected"
+		if p.ConnStatus == 1 {
+			state = "connecting"
+		}
+		if p.ConnStatus == 2 {
+			state = "connected"
+		}
+		result.Peers = append(result.Peers, PeerSnapshot{IP: p.IP, FQDN: p.FQDN, State: state, Relayed: p.Relayed,
+			LastHandshake: p.LastWireguardHandshake, BytesTx: p.BytesTx, BytesRx: p.BytesRx})
+	}
+	sort.Slice(result.Peers, func(i, j int) bool {
+		return result.Peers[i].FQDN+result.Peers[i].IP < result.Peers[j].FQDN+result.Peers[j].IP
+	})
+	return result
+}
+
+// ProbePeer sends one ICMP echo inside the userspace WireGuard tunnel. Only
+// authorized recorder peers are accepted, never arbitrary diagnostic targets.
+func (c *Client) ProbePeer(ctx context.Context, address string) (time.Duration, error) {
+	allowed := false
+	for _, p := range c.ConnectionSnapshot().Peers {
+		if p.IP == address {
+			allowed = true
+			break
+		}
+	}
+	if !allowed || net.ParseIP(address).To4() == nil {
+		return 0, errors.New("not an authorized IPv4 peer")
+	}
+	conn, err := c.DialContext(ctx, "ping4", address)
+	if err != nil {
+		return 0, err
+	}
+	defer conn.Close()
+	stop := context.AfterFunc(ctx, func() { _ = conn.Close() })
+	defer stop()
+	deadline := time.Now().Add(12 * time.Second)
+	if d, ok := ctx.Deadline(); ok && d.Before(deadline) {
+		deadline = d
+	}
+	if err = conn.SetDeadline(deadline); err != nil {
+		return 0, err
+	}
+	nonce := make([]byte, 24)
+	if _, err = rand.Read(nonce); err != nil {
+		return 0, err
+	}
+	id := int(binary.BigEndian.Uint16(nonce[:2]))
+	seq := int(binary.BigEndian.Uint16(nonce[2:4]))
+	request := icmp.Message{Type: ipv4.ICMPTypeEcho, Body: &icmp.Echo{ID: id, Seq: seq, Data: nonce}}
+	wire, err := request.Marshal(nil)
+	if err != nil {
+		return 0, err
+	}
+	started := time.Now()
+	if _, err = conn.Write(wire); err != nil {
+		return 0, err
+	}
+	buffer := make([]byte, 1500)
+	for {
+		n, err := conn.Read(buffer)
+		if err != nil {
+			return 0, err
+		}
+		reply, err := icmp.ParseMessage(1, buffer[:n])
+		if err != nil {
+			continue
+		}
+		echo, ok := reply.Body.(*icmp.Echo)
+		// The netstack assigns the echo identifier when binding the socket.
+		if reply.Type == ipv4.ICMPTypeEchoReply && ok && echo.Seq == seq && string(echo.Data) == string(nonce) {
+			return time.Since(started), nil
+		}
+	}
+}
+func (c *Client) NotifyNetworkChange() {
+	engine, err := c.getEngine()
+	if err == nil {
+		engine.NotifyNetworkChange()
+	}
+}
+
+// SetPhysicalInterfaceDiscoverer supplies Android ConnectivityManager interface
+// data for direct ICE. Install before starting the single embedded client.
+func SetPhysicalInterfaceDiscoverer(fn func() (string, error)) {
+	stdnet.SetPhysicalInterfaceDiscoverer(fn)
+}
