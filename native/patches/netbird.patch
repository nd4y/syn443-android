diff --git a/client/firewall/uspfilter/filter_env_test.go b/client/firewall/uspfilter/filter_env_test.go
new file mode 100644
index 0000000..bc056c3
--- /dev/null
+++ b/client/firewall/uspfilter/filter_env_test.go
@@ -0,0 +1,21 @@
+package uspfilter
+
+import "testing"
+
+func TestStrictUnderlayRejectsNativeForwardingEnvironment(t *testing.T) {
+	for _, variable := range []string{EnvEnableNetstackLocalForwarding, EnvEnableLocalForwarding} {
+		t.Run(variable, func(t *testing.T) {
+			t.Setenv(EnvEnableNetstackLocalForwarding, "")
+			t.Setenv(EnvEnableLocalForwarding, "")
+			t.Setenv(variable, "true")
+			_, enabled, _ := parseCreateEnv(false)
+			if !enabled {
+				t.Fatal("ordinary clients must retain explicitly enabled local forwarding")
+			}
+			_, enabled, _ = parseCreateEnv(true)
+			if enabled {
+				t.Fatal("environment must not enable native sockets in strict underlay mode")
+			}
+		})
+	}
+}
