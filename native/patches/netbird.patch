 func (w *WorkerRelay) OnNewOffer(remoteOfferAnswer *OfferAnswer) {
+	if underlay.DirectEnabled() && remoteOfferAnswer.hasICECredentials() && !w.fallbackAllowed.Load() {
+		offer := *remoteOfferAnswer
+		w.relayLock.Lock()
+		if w.fallbackAllowed.Load() {
+			w.relayLock.Unlock()
+			w.openOffer(remoteOfferAnswer)
+			return
+		}
+		w.pendingOffer = &offer
+		if w.pendingDirect {
+			w.relayLock.Unlock()
+			return
+		}
+		w.pendingDirect = true
+		w.relayLock.Unlock()
+		go func() {
+			active := func() bool { w.conn.mu.Lock(); defer w.conn.mu.Unlock(); return w.conn.isICEActive() }
+			if !waitDirectFallback(w.peerCtx, 8*time.Second, w.directLost, active) {
+				return
+			}
+			w.relayLock.Lock()
+			offer := w.pendingOffer
+			w.pendingOffer = nil
+			w.pendingDirect = false
+			w.fallbackAllowed.Store(true)
+			w.relayLock.Unlock()
+			if offer != nil && w.peerCtx.Err() == nil {
+				w.openOffer(offer)
+			}
+		}()
+		return
+	}
+	w.openOffer(remoteOfferAnswer)
+}
+
+// Relay negotiation is held back while ICE gets its initial connection window.
+// Once P2P succeeds, no per-peer relay is opened until that connection is lost.
+// Offers keep updating independently, so fallback uses the latest relay address.
+func waitDirectFallback(ctx context.Context, grace time.Duration, lost <-chan struct{}, active func() bool) bool {
+	timer := time.NewTimer(grace)
+	defer timer.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return false
+		case <-timer.C:
+		case <-lost:
+		}
+		if ctx.Err() != nil {
+			return false
+		}
+		if !active() {
+			return true
+		}
+	}
+}
+
+func (w *WorkerRelay) NotifyDirectLost() {
+	select {
+	case w.directLost <- struct{}{}:
+	default:
+	}
+}
+
+func (w *WorkerRelay) openOffer(remoteOfferAnswer *OfferAnswer) {
 	if !w.isRelaySupported(remoteOfferAnswer) {
 		w.log.Infof("Relay is not supported by remote peer")
 		w.relaySupportedOnRemotePeer.Store(false)
