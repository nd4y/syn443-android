+type embeddedDiscover struct{ fn func() (string, error) }
+
+func (d embeddedDiscover) IFaces() (string, error) { return d.fn() }
+func SetPhysicalInterfaceDiscoverer(fn func() (string, error)) {
+	physicalDiscover.Lock()
+	physicalDiscover.fn = fn
+	physicalDiscover.Unlock()
