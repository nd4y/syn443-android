+++ b/client/internal/peer/direct_first_test.go
@@ -0,0 +1,49 @@
+package peer
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestDirectFirstDefersRelayUntilUnreachable(t *testing.T) {
+	started := time.Now()
+	if !waitDirectFallback(context.Background(), 20*time.Millisecond, make(chan struct{}), func() bool { return false }) {
+		t.Fatal("fallback missing")
+	}
+	if time.Since(started) < 20*time.Millisecond {
+		t.Fatal("relay raced the direct connection")
+	}
+}
+func TestSuccessfulP2PDoesNotOpenRelayUntilLost(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	lost := make(chan struct{}, 1)
+	var active atomic.Bool
+	active.Store(true)
+	done := make(chan bool, 1)
+	go func() { done <- waitDirectFallback(ctx, 5*time.Millisecond, lost, active.Load) }()
+	select {
+	case <-done:
+		t.Fatal("relay opened despite working P2P")
+	case <-time.After(25 * time.Millisecond):
+	}
+	active.Store(false)
+	lost <- struct{}{}
+	select {
+	case ok := <-done:
+		if !ok {
+			t.Fatal("fallback missing")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("fallback blocked")
+	}
+}
+func TestDirectFirstWaitCancelsWithEngine(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if waitDirectFallback(ctx, time.Hour, make(chan struct{}), func() bool { return false }) {
+		t.Fatal("cancelled engine opened relay")
+	}
+}
