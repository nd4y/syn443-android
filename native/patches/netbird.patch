+package underlay
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+)
+
+func TestExplicitDirectLeaseCanSwitchBackToStrictWithoutFallback(t *testing.T) {
+	t.Cleanup(func() {
+		state.Lock()
+		state.dialer = nil
+		state.active = false
+		state.strict = false
+		state.resolver = nil
+		state.Unlock()
+	})
+	resolver := func(context.Context, string) ([]net.IPAddr, error) {
+		return []net.IPAddr{{IP: net.ParseIP("192.0.2.4")}}, nil
+	}
+	proxy := dialFunc(func(context.Context, string, string) (net.Conn, error) { return nil, errors.New("proxy") })
+	release, err := Acquire(proxy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = AcquireDirect(resolver); !errors.Is(err, ErrInUse) {
+		t.Fatal("direct stole proxy lease", err)
+	}
+	release()
+	direct, err := AcquireDirect(resolver)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if Enabled() || !DirectEnabled() {
+		t.Fatal("direct did not enable P2P")
+	}
+	ips, err := LookupIPAddr(context.Background(), "physical.example")
+	if err != nil || len(ips) != 1 || ips[0].IP.String() != "192.0.2.4" {
+		t.Fatal(ips, err)
+	}
+	if _, err = Acquire(proxy); !errors.Is(err, ErrInUse) {
+		t.Fatal("proxy stole direct lease", err)
+	}
+	direct()
+	direct()
+	if !Enabled() || DirectEnabled() {
+		t.Fatal("late callbacks not blocked")
+	}
+	if _, err = LookupIPAddr(context.Background(), "physical.example"); !errors.Is(err, ErrDirectBlocked) {
+		t.Fatal(err)
+	}
+	release, err = Acquire(proxy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	release()
+}
diff --git a/client/underlay/underlay.go b/client/underlay/underlay.go
new file mode 100644
index 0000000..927ef56
--- /dev/null
+++ b/client/underlay/underlay.go
@@ -0,0 +1,116 @@
+// Package underlay provides the process-wide transport boundary for embedded clients.
+package underlay
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+)
+
+// Dialer carries NetBird control and relay connections through an embedding proxy.
+// Hostnames are deliberately passed unchanged so DNS resolution happens at the proxy.
+type Dialer interface {
+	DialContext(context.Context, string, string) (net.Conn, error)
+}
+
+var (
+	ErrInUse         = errors.New("a proxied NetBird client is already running")
+	ErrDirectBlocked = errors.New("direct networking is disabled by the NetBird underlay")
+	state            struct {
+		sync.RWMutex
+		dialer   Dialer
+		strict   bool
+		active   bool
+		resolver func(context.Context, string) ([]net.IPAddr, error)
+	}
+)
+
+// Acquire installs a fail-closed TCP transport until its returned release function
+// is called. The owner must stop every engine goroutine before releasing the lease.
+// After release, late callbacks remain blocked until another transport is acquired.
+func Acquire(dialer Dialer) (func(), error) {
+	if dialer == nil {
+		return nil, errors.New("nil underlay dialer")
+	}
+	state.Lock()
+	defer state.Unlock()
+	if state.active {
+		return nil, ErrInUse
+	}
+	state.dialer = dialer
+	state.active = true
+	state.strict = true
+	var once sync.Once
+	return func() { once.Do(func() { state.Lock(); state.dialer = nil; state.active = false; state.Unlock() }) }, nil
+}
+
+// Enabled reports whether all host networking must stay inside the custom transport.
+func Enabled() bool {
+	state.RLock()
+	defer state.RUnlock()
+	return state.strict
+}
+
+// Dial calls only the configured transport. UDP and absent transports fail closed.
+func Dial(ctx context.Context, network, address string) (net.Conn, error) {
+	state.RLock()
+	dialer := state.dialer
+	state.RUnlock()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if dialer == nil || (network != "tcp" && network != "tcp4" && network != "tcp6") {
+		return nil, ErrDirectBlocked
+	}
+	return dialer.DialContext(ctx, network, address)
+}
+
+// LookupIPAddr prevents an auxiliary cache or route updater from using host DNS.
+// Control/relay names are resolved by the proxy; overlay names use the netstack.
+func LookupIPAddr(ctx context.Context, host string) ([]net.IPAddr, error) {
+	if ip := net.ParseIP(host); ip != nil {
+		return []net.IPAddr{{IP: ip}}, nil
+	}
+	if Enabled() {
+		return nil, ErrDirectBlocked
+	}
+	state.RLock()
+	resolver := state.resolver
+	state.RUnlock()
+	if resolver != nil {
+		return resolver(ctx, host)
+	}
+	return net.DefaultResolver.LookupIPAddr(ctx, host)
+}
+
+// AcquireDirect explicitly owns protected physical networking. Release blocks late
+// callbacks; changing modes requires the previous engine to have completely stopped.
+func AcquireDirect(resolver func(context.Context, string) ([]net.IPAddr, error)) (func(), error) {
+	if resolver == nil {
+		return nil, errors.New("direct networking requires a physical resolver")
+	}
+	state.Lock()
+	defer state.Unlock()
+	if state.active {
+		return nil, ErrInUse
+	}
+	state.active = true
+	state.strict = false
+	state.resolver = resolver
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			state.Lock()
+			defer state.Unlock()
+			state.active = false
+			state.strict = true
+			state.resolver = nil
+		})
+	}, nil
+}
+func DirectEnabled() bool {
+	state.RLock()
+	defer state.RUnlock()
+	return state.active && !state.strict && state.resolver != nil
+}
diff --git a/client/underlay/underlay_test.go b/client/underlay/underlay_test.go
new file mode 100644
index 0000000..28a8d41
--- /dev/null
+++ b/client/underlay/underlay_test.go
@@ -0,0 +1,67 @@
+package underlay
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+)
+
+type dialFunc func(context.Context, string, string) (net.Conn, error)
+
+func (f dialFunc) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	return f(ctx, network, address)
+}
+
+func TestExclusiveFailClosedTransport(t *testing.T) {
+	t.Cleanup(func() { state.Lock(); state.dialer = nil; state.strict = false; state.Unlock() })
+	if _, err := Acquire(nil); err == nil {
+		t.Fatal("nil transport accepted")
+	}
+	wantErr := errors.New("proxy unavailable")
+	calls := 0
+	d := dialFunc(func(_ context.Context, network, address string) (net.Conn, error) {
+		calls++
+		if network != "tcp" || address != "unresolvable.example.invalid:443" {
+			t.Fatalf("proxy did not receive the untouched hostname: %s %s", network, address)
+		}
+		return nil, wantErr
+	})
+	release, err := Acquire(d)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Acquire(d); !errors.Is(err, ErrInUse) {
+		t.Fatalf("second owner: %v", err)
+	}
+	if _, err := Dial(context.Background(), "tcp", "unresolvable.example.invalid:443"); !errors.Is(err, wantErr) {
+		t.Fatalf("proxy error lost or direct fallback occurred: %v", err)
+	}
+	if _, err := Dial(context.Background(), "udp", "1.1.1.1:53"); !errors.Is(err, ErrDirectBlocked) {
+		t.Fatalf("UDP not blocked: %v", err)
+	}
+	if _, err := LookupIPAddr(context.Background(), "unresolvable.example.invalid"); !errors.Is(err, ErrDirectBlocked) {
+		t.Fatalf("host resolver not blocked: %v", err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := Dial(ctx, "tcp", "unresolvable.example.invalid:443"); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancellation ignored: %v", err)
+	}
+	if calls != 1 {
+		t.Fatalf("unexpected proxy calls: %d", calls)
+	}
+	release()
+	release()
+	if !Enabled() {
+		t.Fatal("release re-enabled direct networking")
+	}
+	if _, err := Dial(context.Background(), "tcp", "unresolvable.example.invalid:443"); !errors.Is(err, ErrDirectBlocked) {
+		t.Fatalf("late dial did not fail closed: %v", err)
+	}
+	releaseAgain, err := Acquire(d)
+	if err != nil {
+		t.Fatalf("restart failed: %v", err)
+	}
+	releaseAgain()
+}
