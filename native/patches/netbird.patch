+// Package underlaytest exercises the proxy boundary without changing host routing
+// or opening network listeners. It is separate because strict mode is permanent
+// for a process after the first proxied client starts.
+package underlaytest
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/coder/websocket"
+	wgconn "golang.zx2c4.com/wireguard/conn"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/health"
+	healthpb "google.golang.org/grpc/health/grpc_health_v1"
+	"google.golang.org/grpc/test/bufconn"
+
+	nbgrpc "github.com/netbirdio/netbird/client/grpc"
+	"github.com/netbirdio/netbird/client/iface/bind"
+	"github.com/netbirdio/netbird/client/iface/wgaddr"
+	"github.com/netbirdio/netbird/client/internal/peer"
+	nbnet "github.com/netbirdio/netbird/client/net"
+	"github.com/netbirdio/netbird/client/underlay"
+	"github.com/netbirdio/netbird/shared/relay/client/dialer/ws"
+)
+
+type proxyDialer struct {
+	mu           sync.Mutex
+	addresses    []string
+	grpcListener *bufconn.Listener
+	wsListener   *bufconn.Listener
+}
+
+func (p *proxyDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	p.mu.Lock()
+	p.addresses = append(p.addresses, address)
+	p.mu.Unlock()
+	if network != "tcp" {
+		return nil, errors.New("unexpected non-TCP underlay")
+	}
+	switch address {
+	case "management.invalid:443":
+		return p.grpcListener.DialContext(ctx)
+	case "relay.invalid:80":
+		return p.wsListener.DialContext(ctx)
+	default:
+		return nil, errors.New("proxy rejected destination")
+	}
+}
+
+func TestControlAndRelayUseOnlyUnderlay(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	p := &proxyDialer{grpcListener: bufconn.Listen(65536), wsListener: bufconn.Listen(65536)}
+	defer p.grpcListener.Close()
+	defer p.wsListener.Close()
+	release, err := underlay.Acquire(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer release()
+	t.Setenv("HTTP_PROXY", "http://unreachable.invalid:1")
+	t.Setenv("HTTPS_PROXY", "http://unreachable.invalid:1")
+	server := grpc.NewServer()
+	healthpb.RegisterHealthServer(server, health.NewServer())
+	go server.Serve(p.grpcListener)
+	defer server.Stop()
+	conn, err := nbgrpc.CreateConnection(ctx, "management.invalid:443", false, "/management")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if _, err := healthpb.NewHealthClient(conn).Check(ctx, &healthpb.HealthCheckRequest{}); err != nil {
+		t.Fatal(err)
+	}
+
+	httpServer := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		c, err := websocket.Accept(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer c.CloseNow()
+		typ, msg, err := c.Read(ctx)
+		if err == nil {
+			_ = c.Write(ctx, typ, msg)
+		}
+	})}
+	go httpServer.Serve(p.wsListener)
+	defer httpServer.Close()
+	relay, err := (ws.Dialer{}).Dial(ctx, "rel://relay.invalid:80", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer relay.Close()
+	if _, err := relay.Write([]byte("encrypted-wireguard-payload")); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 128)
+	n, err := relay.Read(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(buf[:n]) != "encrypted-wireguard-payload" {
+		t.Fatal("relay payload changed")
+	}
+	if !peer.IsForceRelayed() {
+		t.Fatal("ICE is still permitted")
+	}
+
+	b := bind.NewICEBind(nil, wgaddr.Address{}, 1280)
+	receivers, _, err := b.Open(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(receivers) != 1 {
+		t.Fatalf("host socket receivers opened: %d", len(receivers))
+	}
+	if _, err := b.GetICEMux(); !errors.Is(err, bind.ErrUDPMUXNotSupported) {
+		t.Fatalf("ICE mux enabled: %v", err)
+	}
+	ep := &wgconn.StdNetEndpoint{AddrPort: netip.MustParseAddrPort("192.0.2.1:51820")}
+	if err := b.Send([][]byte{{1, 2, 3}}, ep); !errors.Is(err, underlay.ErrDirectBlocked) {
+		t.Fatalf("direct WireGuard send: %v", err)
+	}
+	if err := b.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := nbnet.NewListener().ListenPacket(ctx, "udp", "127.0.0.1:0"); !errors.Is(err, underlay.ErrDirectBlocked) {
+		t.Fatalf("UDP listener bypass: %v", err)
+	}
+	release()
+	if _, err := nbnet.NewDialer().DialContext(ctx, "tcp", "management.invalid:443"); !errors.Is(err, underlay.ErrDirectBlocked) {
+		t.Fatalf("direct fallback after stop: %v", err)
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if len(p.addresses) != 2 || p.addresses[0] != "management.invalid:443" || p.addresses[1] != "relay.invalid:80" {
+		t.Fatalf("unexpected proxy destinations: %v", p.addresses)
+	}
+}
