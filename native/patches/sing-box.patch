--- /dev/null
+++ b/route/network_reset.go
@@ -0,0 +1,23 @@
+package route
+
+import "github.com/sagernet/sing-box/adapter"
+
+// Health scans depend on the member transports. Reset those transports before
+// groups launch new-network probes, otherwise the reset cancels the new probes.
+func notifyOutboundInterfaceUpdates(outbounds []adapter.Outbound) {
+	var groups []adapter.InterfaceUpdateListener
+	for _, outbound := range outbounds {
+		listener, ok := outbound.(adapter.InterfaceUpdateListener)
+		if !ok {
+			continue
+		}
+		if _, group := outbound.(adapter.OutboundGroup); group {
+			groups = append(groups, listener)
+		} else {
+			listener.InterfaceUpdated()
+		}
+	}
+	for _, group := range groups {
+		group.InterfaceUpdated()
+	}
+}
