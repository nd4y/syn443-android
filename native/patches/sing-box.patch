diff --git a/protocol/group/urltest_selection.go b/protocol/group/urltest_selection.go
new file mode 100644
index 0000000..2a0ec2d
--- /dev/null
+++ b/protocol/group/urltest_selection.go
@@ -0,0 +1,140 @@
+package group
+
+import (
+	"context"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	E "github.com/sagernet/sing/common/exceptions"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func (g *URLTestGroup) selected(network string) adapter.Outbound {
+	g.selectionAccess.RLock()
+	defer g.selectionAccess.RUnlock()
+	if network == N.NetworkTCP {
+		return g.selectedOutboundTCP
+	}
+	return g.selectedOutboundUDP
+}
+
+func (g *URLTestGroup) historyFor(network string) adapter.URLTestHistoryStorage {
+	if network == N.NetworkUDP && g.udpLink != "" {
+		return g.udpHistory
+	}
+	return g.history
+}
+
+type urlTestScan struct {
+	generation uint64
+	ctx        context.Context
+	cancel     context.CancelFunc
+	stopClose  func() bool
+}
+
+// Reserve under the selection lock before launching a goroutine. A retired
+// scan may still be unwinding an uncooperative transport, but cannot own or
+// delay a scan for a newer network.
+func (g *URLTestGroup) reserveScan(ctx context.Context) *urlTestScan {
+	g.selectionAccess.Lock()
+	defer g.selectionAccess.Unlock()
+	if g.probeCtx.Err() != nil || g.activeProbe != nil {
+		return nil
+	}
+	checkCtx, cancel := context.WithCancel(ctx)
+	scan := &urlTestScan{generation: g.generation.Load(), ctx: checkCtx, cancel: cancel}
+	scan.stopClose = context.AfterFunc(g.probeCtx, cancel)
+	g.activeProbe = scan
+	g.checking.Store(true)
+	return scan
+}
+
+func (g *URLTestGroup) ensureCheck() {
+	if scan := g.reserveScan(g.probeCtx); scan != nil {
+		go g.runURLTest(scan, false)
+	}
+}
+
+func (g *URLTestGroup) selectVerified(network string) (adapter.Outbound, bool) {
+	g.selectionAccess.Lock()
+	defer g.selectionAccess.Unlock()
+	outbound, verified := g.selectLocked(network)
+	if verified {
+		// Remember the member actually used before the full scan completes, so a
+		// later better choice interrupts internal UDP binds connected to that member.
+		if network == N.NetworkTCP && g.selectedOutboundTCP == nil {
+			g.selectedOutboundTCP = outbound
+		} else if network == N.NetworkUDP && g.selectedOutboundUDP == nil {
+			g.selectedOutboundUDP = outbound
+		}
+	}
+	return outbound, verified
+}
+
+// Bootstrap DNS and WireGuard can dial before PostStart's background scan finishes.
+// Wait only for the first confirmed member, not the slowest failed probe in the pool.
+func (g *URLTestGroup) selectReady(ctx context.Context, network string) (adapter.Outbound, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := g.probeCtx.Err(); err != nil {
+		return nil, err
+	}
+	if outbound, verified := g.selectVerified(network); verified {
+		return outbound, nil
+	}
+	g.ensureCheck()
+	ticker := time.NewTicker(10 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if err := g.probeCtx.Err(); err != nil {
+			return nil, err
+		}
+		if outbound, verified := g.selectVerified(network); verified {
+			return outbound, nil
+		}
+		if !g.checking.Load() {
+			if g.completedGeneration.Load() == g.generation.Load() {
+				return nil, E.New("no available outbound for ", network)
+			}
+			g.ensureCheck()
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-g.probeCtx.Done():
+			return nil, g.probeCtx.Err()
+		case <-ticker.C:
+		}
+	}
+}
+
+func (g *URLTestGroup) invalidateNetwork() {
+	g.selectionAccess.Lock()
+	g.generation.Add(1)
+	if g.activeProbe != nil {
+		g.activeProbe.cancel()
+		g.activeProbe = nil
+	}
+	g.checking.Store(false)
+	g.selectedOutboundTCP = nil
+	g.selectedOutboundUDP = nil
+	for _, member := range g.outbounds {
+		g.history.DeleteURLTestHistory(RealTag(member))
+		g.udpHistory.DeleteURLTestHistory(RealTag(member))
+	}
+	g.selectionAccess.Unlock()
+	g.ensureCheck()
+}
+
+// A late failure from the old network or a closed box must not delete health
+// learned by the current network/box from shared storage. Caller cancellation
+// is also not evidence that a member is unavailable.
+func (g *URLTestGroup) forgetFailedDial(ctx context.Context, generation uint64, network, tag string) {
+	g.selectionAccess.Lock()
+	defer g.selectionAccess.Unlock()
+	if ctx.Err() != nil || g.probeCtx.Err() != nil || generation != g.generation.Load() {
+		return
+	}
+	g.historyFor(network).DeleteURLTestHistory(tag)
+}
