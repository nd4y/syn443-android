--- /dev/null
+++ b/common/urltest/udp.go
@@ -0,0 +1,91 @@
+package urltest
+
+import (
+	"context"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/miekg/dns"
+)
+
+func parseUDPURL(link string) (M.Socksaddr, string, error) {
+	u, err := url.Parse(link)
+	if err != nil || u.Scheme != "udp" || u.User != nil || u.Fragment != "" || (u.Path != "" && u.Path != "/") {
+		return M.Socksaddr{}, "", E.New("invalid UDP probe URL")
+	}
+	ip, err := netip.ParseAddr(u.Hostname())
+	if err != nil || ip.IsUnspecified() || ip.IsMulticast() {
+		return M.Socksaddr{}, "", E.New("UDP probe requires a literal DNS server address")
+	}
+	port := uint64(53)
+	if u.Port() != "" {
+		port, err = strconv.ParseUint(u.Port(), 10, 16)
+		if err != nil || port == 0 {
+			return M.Socksaddr{}, "", E.New("invalid UDP probe port")
+		}
+	}
+	name := u.Query().Get("name")
+	if name == "" {
+		name = "example.com"
+	}
+	if _, valid := dns.IsDomainName(dns.Fqdn(name)); !valid || len(name) > 253 {
+		return M.Socksaddr{}, "", E.New("invalid UDP probe DNS question")
+	}
+	return M.Socksaddr{Addr: ip, Port: uint16(port)}, dns.Fqdn(name), nil
+}
+
+func ValidateUDPURL(link string) error {
+	_, _, err := parseUDPURL(link)
+	return err
+}
+
+// UDPTest verifies a DNS response through the member's actual UDP transport.
+// A literal server address avoids depending on the DNS this group bootstraps.
+func UDPTest(ctx context.Context, link string, detour N.Dialer) (uint16, error) {
+	destination, name, err := parseUDPURL(link)
+	if err != nil {
+		return 0, err
+	}
+	start := time.Now()
+	conn, err := detour.DialContext(ctx, N.NetworkUDP, destination)
+	if err != nil {
+		return 0, err
+	}
+	defer conn.Close()
+	stop := context.AfterFunc(ctx, func() { _ = conn.Close() })
+	defer stop()
+	deadline := start.Add(C.TCPTimeout)
+	if bound, ok := ctx.Deadline(); ok && bound.Before(deadline) {
+		deadline = bound
+	}
+	_ = conn.SetDeadline(deadline)
+	question := new(dns.Msg).SetQuestion(name, dns.TypeA)
+	payload, err := question.Pack()
+	if err != nil {
+		return 0, err
+	}
+	if _, err = conn.Write(payload); err != nil {
+		return 0, err
+	}
+	buffer := make([]byte, 4096)
+	n, err := conn.Read(buffer)
+	if err != nil {
+		return 0, err
+	}
+	var answer dns.Msg
+	if err = answer.Unpack(buffer[:n]); err != nil {
+		return 0, err
+	}
+	if !answer.Response || answer.Id != question.Id || answer.Truncated || answer.Rcode != dns.RcodeSuccess || len(answer.Answer) == 0 || len(answer.Question) != 1 || !strings.EqualFold(answer.Question[0].Name, name) || answer.Question[0].Qtype != dns.TypeA || answer.Question[0].Qclass != dns.ClassINET {
+		return 0, E.New("invalid UDP probe DNS response")
+	}
+	return uint16(max(1, min(65535, time.Since(start)/time.Millisecond))), nil
+}
