+package transport
+
+import (
+	M "github.com/sagernet/sing/common/metadata"
+	"testing"
+)
+
+func TestHTTPSTransportCloneDoesNotReuseOldPools(t *testing.T) {
+	old := NewHTTPSTransportWrapper(nil, M.Socksaddr{})
+	old.fallback.Store(true)
+	next := old.Clone()
+	if next.httpTransport == old.httpTransport || next.http2Transport == old.http2Transport || next.fallback == old.fallback {
+		t.Fatal("network clone retained old pool state")
+	}
+	if next.fallback.Load() {
+		t.Fatal("new network inherited old ALPN fallback")
+	}
+}
