@@ -0,0 +1,433 @@
+package group
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type healthOutbound struct {
+	outbound.Adapter
+	dial    func(context.Context) (net.Conn, error)
+	udpDial func(context.Context) (net.Conn, error)
+	packet  func(context.Context) (net.PacketConn, error)
+}
+
+func (o *healthOutbound) DialContext(ctx context.Context, network string, _ M.Socksaddr) (net.Conn, error) {
+	if network == N.NetworkUDP && o.udpDial != nil {
+		return o.udpDial(ctx)
+	}
+	return o.dial(ctx)
+}
+
+func (o *healthOutbound) ListenPacket(ctx context.Context, _ M.Socksaddr) (net.PacketConn, error) {
+	if o.packet != nil {
+		return o.packet(ctx)
+	}
+	return nil, errors.New("not used")
+}
+
+type healthManager struct {
+	adapter.OutboundManager
+	members map[string]adapter.Outbound
+}
+
+func (m healthManager) Outbound(tag string) (adapter.Outbound, bool) {
+	o, ok := m.members[tag]
+	return o, ok
+}
+
+func healthyPipe(context.Context) (net.Conn, error) {
+	client, server := net.Pipe()
+	go func() {
+		defer server.Close()
+		if _, err := http.ReadRequest(bufio.NewReader(server)); err == nil {
+			_, _ = server.Write([]byte("HTTP/1.1 204 No Content\r\nContent-Length: 0\r\n\r\n"))
+		}
+	}()
+	return client, nil
+}
+
+func unavailable(context.Context) (net.Conn, error) { return nil, errors.New("offline") }
+func waiting(ctx context.Context) (net.Conn, error) { <-ctx.Done(); return nil, ctx.Err() }
+
+func newHealthGroup(t *testing.T, dials ...func(context.Context) (net.Conn, error)) *URLTestGroup {
+	t.Helper()
+	m := healthManager{members: make(map[string]adapter.Outbound)}
+	var members []adapter.Outbound
+	for i, dial := range dials {
+		tag := string(rune('a' + i))
+		o := &healthOutbound{Adapter: outbound.NewAdapter("test", tag, []string{N.NetworkTCP, N.NetworkUDP}, nil), dial: dial}
+		members = append(members, o)
+		m.members[tag] = o
+	}
+	g, err := NewURLTestGroup(context.Background(), m, log.NewNOPFactory().Logger(), members, "http://probe.invalid/", time.Minute, 50, time.Minute, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = g.Close() })
+	return g
+}
+
+func finishCheck(t *testing.T, g *URLTestGroup) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for g.checking.Load() {
+		if time.Now().After(deadline) {
+			t.Fatal("check did not stop")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func TestURLTestBootstrapWaitsForFirstHealthyMember(t *testing.T) {
+	g := newHealthGroup(t, waiting, healthyPipe, waiting)
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	o, err := g.selectReady(ctx, N.NetworkTCP)
+	if err != nil || o.Tag() != "b" {
+		t.Fatalf("selected %v, err %v", o, err)
+	}
+	if !g.checking.Load() {
+		t.Fatal("waited for unavailable siblings instead of first healthy result")
+	}
+	if selected := g.selected(N.NetworkTCP); selected == nil || selected.Tag() != "b" {
+		t.Fatal("first used member was not recorded for later bind interruption")
+	}
+	_ = g.Close()
+	finishCheck(t, g)
+}
+
+func TestURLTestInvalidatesPreviousNetwork(t *testing.T) {
+	var phase atomic.Bool
+	g := newHealthGroup(t, func(ctx context.Context) (net.Conn, error) {
+		if phase.Load() {
+			return unavailable(ctx)
+		}
+		return healthyPipe(ctx)
+	}, func(ctx context.Context) (net.Conn, error) {
+		if phase.Load() {
+			return healthyPipe(ctx)
+		}
+		return unavailable(ctx)
