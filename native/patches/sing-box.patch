+)
+
+type deadlineDialer struct{ conn net.Conn }
+
+func (d deadlineDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return d.conn, nil
+}
+func (deadlineDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	panic("unused")
+}
+
+type deadlineConfig struct {
+	Config
+	observed func(context.Context)
+}
+
+func (c deadlineConfig) Client(conn net.Conn) (Conn, error) {
+	return deadlineConn{Conn: conn, observed: c.observed}, nil
+}
+
+type deadlineConn struct {
+	net.Conn
+	observed func(context.Context)
+}
+
+func (c deadlineConn) NetConn() net.Conn                { return c.Conn }
+func (c deadlineConn) ConnectionState() ConnectionState { return ConnectionState{} }
+func (c deadlineConn) HandshakeContext(ctx context.Context) error {
+	c.observed(ctx)
+	return errors.New("test handshake")
+}
+
+func TestDefaultDialerBoundsBackgroundTLSHandshake(t *testing.T) {
+	client, peer := net.Pipe()
+	defer peer.Close()
+	defer client.Close()
+	observed := false
+	d := NewDialer(deadlineDialer{client}, deadlineConfig{observed: func(ctx context.Context) {
+		observed = true
+		deadline, ok := ctx.Deadline()
+		if !ok || time.Until(deadline) > C.TCPTimeout+time.Second {
+			t.Error("unbounded TLS handshake")
+		}
+	}})
+	_, _ = d.DialTLSContext(context.Background(), M.Socksaddr{})
+	if !observed {
+		t.Fatal("handshake not exercised")
+	}
+}
