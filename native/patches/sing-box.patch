+package route
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	"testing"
+)
+
+type resetMember struct {
+	adapter.Outbound
+	reset bool
+}
+
+func (m *resetMember) InterfaceUpdated() { m.reset = true }
+
+type resetGroup struct {
+	adapter.Outbound
+	member  *resetMember
+	checked bool
+	t       *testing.T
+}
+
+func (g *resetGroup) Now() string   { return "" }
+func (g *resetGroup) All() []string { return nil }
+func (g *resetGroup) InterfaceUpdated() {
+	g.checked = true
+	if !g.member.reset {
+		g.t.Error("group probed before member transport reset")
+	}
+}
+
+func TestNetworkResetUpdatesTransportsBeforeGroups(t *testing.T) {
+	m1, m2 := &resetMember{}, &resetMember{}
+	g1, g2 := &resetGroup{member: m1, t: t}, &resetGroup{member: m2, t: t}
+	notifyOutboundInterfaceUpdates([]adapter.Outbound{g1, m1, g2, m2})
+	if !g1.checked || !g2.checked {
+		t.Fatal("group notification missing")
+	}
+}
