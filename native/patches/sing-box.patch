@@ -0,0 +1,123 @@
+package transport
+
+import (
+	"context"
+	stdtls "crypto/tls"
+	"crypto/x509"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	mDNS "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/common/tls"
+	"github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type retryTLSDialer struct {
+	calls      atomic.Int32
+	firstError error
+	alwaysFail bool
+	trusted    bool
+	addr       string
+	roots      *x509.CertPool
+}
+
+func (d *retryTLSDialer) DialTLSContext(ctx context.Context, _ M.Socksaddr) (tls.Conn, error) {
+	n := d.calls.Add(1)
+	if n == 1 || d.alwaysFail {
+		return nil, d.firstError
+	}
+	roots := d.roots
+	if !d.trusted {
+		roots = x509.NewCertPool()
+	}
+	conn, err := (&stdtls.Dialer{Config: &stdtls.Config{RootCAs: roots, ServerName: "example.com", NextProtos: []string{"h2"}}}).DialContext(ctx, "tcp", d.addr)
+	if err != nil {
+		return nil, err
+	}
+	return conn.(*stdtls.Conn), nil
+}
+func (*retryTLSDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	panic("unused")
+}
+func (*retryTLSDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	panic("unused")
+}
+
+func TestHTTPSTransportRetriesInterruptedInternalDial(t *testing.T) {
+	srv := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		raw, _ := io.ReadAll(r.Body)
+		var q mDNS.Msg
+		if q.Unpack(raw) != nil {
+			w.WriteHeader(400)
+			return
+		}
+		var a mDNS.Msg
+		a.SetReply(&q)
+		raw, _ = a.Pack()
+		w.Header().Set("Content-Type", MimeType)
+		_, _ = w.Write(raw)
+	}))
+	srv.EnableHTTP2 = true
+	srv.StartTLS()
+	defer srv.Close()
+	roots := x509.NewCertPool()
+	roots.AddCert(srv.Certificate())
+	for _, tc := range []struct {
+		name                  string
+		err                   error
+		always, trust, wantOK bool
+		wantCalls             int32
+	}{
+		{"closed-pipe", io.ErrClosedPipe, false, true, true, 2},
+		{"eof", io.EOF, false, true, true, 2},
+		{"internal-timeout", context.DeadlineExceeded, false, true, true, 2},
+		{"internal-cancel", context.Canceled, false, true, true, 2},
+		{"persistent", io.ErrClosedPipe, true, true, false, 2},
+		{"certificate", x509.UnknownAuthorityError{}, true, false, false, 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			d := &retryTLSDialer{firstError: tc.err, alwaysFail: tc.always, trusted: tc.trust, addr: srv.Listener.Addr().String(), roots: roots}
+			destination, _ := url.Parse(srv.URL + "/dns-query")
+			tr := &HTTPSTransport{TransportAdapter: dns.TransportAdapter{}, logger: log.NewNOPFactory().Logger(), destination: destination, headers: make(http.Header), transport: NewHTTPSTransportWrapper(d, M.Socksaddr{})}
+			defer tr.Close()
+			q := new(mDNS.Msg)
+			q.SetQuestion("example.com.", mDNS.TypeA)
+			ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+			defer cancel()
+			answer, err := tr.Exchange(ctx, q)
+			if (err == nil) != tc.wantOK {
+				t.Fatalf("answer=%v error=%v", answer, err)
+			}
+			if d.calls.Load() != tc.wantCalls {
+				t.Fatalf("dials=%d, want %d", d.calls.Load(), tc.wantCalls)
+			}
+		})
+	}
+}
+
+func TestHTTPSTransportDoesNotRetryCanceledCaller(t *testing.T) {
+	d := &retryTLSDialer{firstError: context.Canceled, alwaysFail: true}
+	destination, _ := url.Parse("https://example.com/dns-query")
+	tr := &HTTPSTransport{destination: destination, headers: make(http.Header), transport: NewHTTPSTransportWrapper(d, M.Socksaddr{})}
+	defer tr.Close()
+	q := new(mDNS.Msg)
+	q.SetQuestion("example.com.", mDNS.TypeA)
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	_, err := tr.Exchange(ctx, q)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	if d.calls.Load() > 1 {
+		t.Fatalf("canceled caller retried %d times", d.calls.Load())
+	}
+}
