--- /dev/null
+++ b/transport/v2rayxhttp/client_streams.go
@@ -0,0 +1,89 @@
+package xhttp
+
+import (
+	"context"
+	"net"
+)
+
+type pendingDial struct{ cancel context.CancelFunc }
+
+func (c *Client) beginDial(ctx context.Context) (context.Context, func(), uint64, error) {
+	for {
+		c.streamAccess.Lock()
+		if c.closed.Load() {
+			c.streamAccess.Unlock()
+			return nil, nil, 0, net.ErrClosed
+		}
+		if wait := c.resetDone; wait != nil {
+			c.streamAccess.Unlock()
+			select {
+			case <-wait:
+				continue
+			case <-ctx.Done():
+				return nil, nil, 0, ctx.Err()
+			}
+		}
+		dialCtx, cancel := context.WithCancel(ctx)
+		pending := &pendingDial{cancel: cancel}
+		if c.pending == nil {
+			c.pending = make(map[*pendingDial]struct{})
+		}
+		c.pending[pending] = struct{}{}
+		generation := c.generation
+		c.streamAccess.Unlock()
+		return dialCtx, func() {
+			c.streamAccess.Lock()
+			delete(c.pending, pending)
+			c.streamAccess.Unlock()
+			cancel()
+		}, generation, nil
+	}
+}
+
+func (c *Client) publishStream(conn *splitConn, generation uint64) (net.Conn, error) {
+	c.streamAccess.Lock()
+	if c.closed.Load() || generation != c.generation || c.resetDone != nil {
+		c.streamAccess.Unlock()
+		_ = conn.Close()
+		return nil, net.ErrClosed
+	}
+	if c.streams == nil {
+		c.streams = make(map[*splitConn]struct{})
+	}
+	c.streams[conn] = struct{}{}
+	c.streamAccess.Unlock()
+	return conn, nil
+}
+
+func (c *Client) forgetStream(conn *splitConn) {
+	c.streamAccess.Lock()
+	delete(c.streams, conn)
+	c.streamAccess.Unlock()
+}
+
+// HTTP/2 CloseIdleConnections does not close active XHTTP streams. Network
+// reset must cancel pending dials and close every logical stream from that
+// generation, including internal DoH TLS and WireGuard binds.
+func (c *Client) closeStreams() func() {
+	c.streamAccess.Lock()
+	c.generation++
+	wait := make(chan struct{})
+	c.resetDone = wait
+	pending := c.pending
+	streams := c.streams
+	c.pending = nil
+	c.streams = nil
+	c.streamAccess.Unlock()
+	for dial := range pending {
+		dial.cancel()
+	}
+	for conn := range streams {
+		_ = conn.Close()
+	}
+	return func() {
+		c.streamAccess.Lock()
+		c.resetDone = nil
+		close(wait)
+		c.streamAccess.Unlock()
+	}
+}
