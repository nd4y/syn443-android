+)
+
+type rebindPacketConn struct {
+	fail   bool
+	closed atomic.Bool
+	writes [][]byte
+}
+
+func (*rebindPacketConn) ReadFrom([]byte) (int, net.Addr, error) { return 0, nil, io.EOF }
+func (c *rebindPacketConn) WriteTo(p []byte, _ net.Addr) (int, error) {
+	if c.fail || c.closed.Load() {
+		return 0, io.ErrClosedPipe
+	}
+	c.writes = append(c.writes, append([]byte(nil), p...))
+	return len(p), nil
+}
+func (c *rebindPacketConn) Close() error { c.closed.Store(true); return nil }
+func (*rebindPacketConn) LocalAddr() net.Addr {
+	return &net.UDPAddr{IP: net.IPv4(192, 0, 2, 2), Port: 1234}
+}
+func (*rebindPacketConn) SetDeadline(time.Time) error      { return nil }
+func (*rebindPacketConn) SetReadDeadline(time.Time) error  { return nil }
+func (*rebindPacketConn) SetWriteDeadline(time.Time) error { return nil }
+
+type rebindDialer struct {
+	calls      int
+	persistent bool
+	sockets    []*rebindPacketConn
+}
+
+func (*rebindDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	panic("unused")
+}
+func (d *rebindDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	d.calls++
+	c := &rebindPacketConn{fail: d.calls == 1 || d.persistent}
+	d.sockets = append(d.sockets, c)
+	return c, nil
+}
+
+func TestClientBindRetriesDatagramAfterIdleUplinkCloses(t *testing.T) {
+	d := &rebindDialer{}
+	b := NewClientBind(t.Context(), log.NewNOPFactory().Logger(), d, false, netip.AddrPort{}, [3]uint8{})
+	if _, _, err := b.Open(0); err != nil {
+		t.Fatal(err)
+	}
+	defer b.Close()
+	packet := []byte{9, 9, 1, 8, 8, 8, 5}
+	err := b.Send([][]byte{packet}, remoteEndpoint(netip.MustParseAddrPort("192.0.2.1:51888")), 2)
+	if err != nil {
+		t.Fatalf("first datagram lost on stale uplink: %v", err)
+	}
+	if d.calls != 2 || !d.sockets[0].closed.Load() {
+		t.Fatalf("rebind calls=%d", d.calls)
+	}
+	if len(d.sockets[1].writes) != 1 || !bytes.Equal(d.sockets[1].writes[0], []byte{1, 0, 0, 0, 5}) {
+		t.Fatal("wireguard datagram or reserved bytes changed")
+	}
+}
+
+func TestClientBindPersistentWriteFailureIsBounded(t *testing.T) {
+	d := &rebindDialer{persistent: true}
+	b := NewClientBind(t.Context(), log.NewNOPFactory().Logger(), d, false, netip.AddrPort{}, [3]uint8{})
+	if _, _, err := b.Open(0); err != nil {
+		t.Fatal(err)
+	}
+	defer b.Close()
+	if err := b.Send([][]byte{{1, 2, 3, 4, 5}}, remoteEndpoint(netip.MustParseAddrPort("192.0.2.1:51888")), 0); err == nil {
+		t.Fatal("persistent failure hidden")
+	}
+	if d.calls != 2 {
+		t.Fatalf("dial count=%d, want2", d.calls)
+	}
+}
+
+func TestClientBindConcurrentReconnect(t *testing.T) {
+	d := &rebindDialer{}
+	b := NewClientBind(t.Context(), log.NewNOPFactory().Logger(), d, false, netip.AddrPort{}, [3]uint8{})
+	if _, _, err := b.Open(0); err != nil {
+		t.Fatal(err)
+	}
+	defer b.Close()
+	var wg sync.WaitGroup
+	for i := 0; i < 3; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c, err := b.connect()
+				if err == nil {
+					_ = c.Close()
+				}
+			}
+		}()
+	}
+	wg.Wait()
+}
