+	// DNS POST is idempotent. A network reset or URLTest member update may close
+	// an internal DoH connection while the caller is still alive. Retry once
+	// with a fresh pool, retaining the caller's deadline and certificate policy.
+	for attempt := 0; ; attempt++ {
+		startAt := time.Now()
+		response, err := t.exchange(ctx, message)
+		if err == nil {
+			return response, nil
+		}
+		if !isInterruptedDoHConnection(err) {
+			return nil, err
+		}
+		t.transportAccess.Lock()
+		if !t.transportResetAt.After(startAt) {
 			t.transport.CloseIdleConnections()
 			t.transport = t.transport.Clone()
 			t.transportResetAt = time.Now()
 		}
-		return nil, err
+		t.transportAccess.Unlock()
+		if attempt != 0 || ctx.Err() != nil {
+			return nil, err
+		}
 	}
-	return response, nil
+}
+
+func isInterruptedDoHConnection(err error) bool {
+	return errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) ||
+		errors.Is(err, io.ErrClosedPipe) || errors.Is(err, net.ErrClosed) ||
+		errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.ECONNABORTED) ||
+		errors.Is(err, syscall.EPIPE) || errors.Is(err, context.Canceled) ||
+		errors.Is(err, context.DeadlineExceeded)
 }
 
 func (t *HTTPSTransport) exchange(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
