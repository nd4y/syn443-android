diff --git a/transport/wireguard/pause_device.go b/transport/wireguard/pause_device.go
new file mode 100644
index 0000000..88383da
--- /dev/null
+++ b/transport/wireguard/pause_device.go
@@ -0,0 +1,65 @@
+package wireguard
+
+import (
+	"sync"
+	"sync/atomic"
+)
+
+type pauseDevice interface {
+	Up() error
+	Down() error
+}
+
+// The pause manager invokes callbacks while holding its registration mutex.
+// WireGuard Up/Down may dial through a URLTest detour, which registers a pause
+// ticker. Never perform that work in the callback: it inverts pause/bind locks.
+// One worker coalesces state updates and keeps device transitions ordered.
+type pauseDeviceUpdater struct {
+	device  pauseDevice
+	paused  atomic.Bool
+	stopped atomic.Bool
+	updates chan struct{}
+	stop    chan struct{}
+	done    chan struct{}
+	once    sync.Once
+}
+
+func newPauseDeviceUpdater(device pauseDevice) *pauseDeviceUpdater {
+	u := &pauseDeviceUpdater{device: device, updates: make(chan struct{}, 1), stop: make(chan struct{}), done: make(chan struct{})}
+	go u.run()
+	return u
+}
+
+func (u *pauseDeviceUpdater) update(paused bool) {
+	u.paused.Store(paused)
+	if u.stopped.Load() {
+		return
+	}
+	select {
+	case u.updates <- struct{}{}:
+	default:
+	}
+}
+
+func (u *pauseDeviceUpdater) run() {
+	defer close(u.done)
+	for {
+		select {
+		case <-u.stop:
+			return
+		case <-u.updates:
+			if u.stopped.Load() {
+				return
+			}
+			if u.paused.Load() {
+				_ = u.device.Down()
+			} else {
+				_ = u.device.Up()
+			}
+		}
+	}
+}
+
+func (u *pauseDeviceUpdater) close() {
+	u.once.Do(func() { u.stopped.Store(true); close(u.stop) })
+}
diff --git a/transport/wireguard/pause_device_test.go b/transport/wireguard/pause_device_test.go
new file mode 100644
index 0000000..1993fda
--- /dev/null
+++ b/transport/wireguard/pause_device_test.go
@@ -0,0 +1,97 @@
+package wireguard
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/service"
+	"github.com/sagernet/sing/service/pause"
+)
+
+type testPauseDevice struct {
+	up   func()
+	down func()
+}
+
+func (d *testPauseDevice) Up() error {
+	if d.up != nil {
+		d.up()
+	}
+	return nil
+}
+func (d *testPauseDevice) Down() error {
+	if d.down != nil {
+		d.down()
+	}
+	return nil
+}
+
+func awaitPauseTest(t *testing.T, c <-chan struct{}, message string) {
+	t.Helper()
+	select {
+	case <-c:
+	case <-time.After(2 * time.Second):
+		t.Fatal(message)
+	}
+}
+
+func TestPauseWakeAllowsDetourTickerRegistration(t *testing.T) {
+	// Real deadlock: pause.emit -> WG.Up -> bind mutex, while a receive
+	// goroutine holds that mutex and URLTest.Touch waits to register a ticker.
+	ctx := pause.WithDefaultManager(context.Background())
+	manager := service.FromContext[pause.Manager](ctx)
+	var bind sync.Mutex
+	bind.Lock()
+	register := make(chan struct{})
+	registered := make(chan struct{})
+	upDone := make(chan struct{})
+	updater := newPauseDeviceUpdater(&testPauseDevice{up: func() {
+		bind.Lock()
+		bind.Unlock()
+		close(upDone)
+	}})
+	defer func() { updater.close(); <-updater.done }()
+	manager.NetworkPause()
+	callback := manager.RegisterCallback(func(event int) {
+		if event == pause.EventNetworkWake {
+			close(register)
+			updater.update(false)
+		}
+	})
+	defer manager.UnregisterCallback(callback)
+	go func() {
+		<-register
+		ticker := manager.RegisterCallback(func(int) {})
+		manager.UnregisterCallback(ticker)
+		bind.Unlock()
+		close(registered)
+	}()
+	woke := make(chan struct{})
+	go func() { manager.NetworkWake(); close(woke) }()
+	awaitPauseTest(t, woke, "network callback blocked on WireGuard/detour")
+	awaitPauseTest(t, registered, "detour ticker registration blocked on pause lock")
+	awaitPauseTest(t, upDone, "WireGuard never resumed after detour registration")
+}
+
+func TestPauseUpdaterCoalescesToLatestStateAndStops(t *testing.T) {
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	down := make(chan struct{}, 1)
+	updater := newPauseDeviceUpdater(&testPauseDevice{
+		up:   func() { close(entered); <-release },
+		down: func() { down <- struct{}{} },
+	})
+	updater.update(false)
+	awaitPauseTest(t, entered, "up not called")
+	for i := 0; i < 100; i++ {
+		updater.update(false)
+	}
+	updater.update(true)
+	close(release)
+	awaitPauseTest(t, down, "latest paused state was lost")
+	updater.close()
+	<-updater.done
+	updater.update(false) // Closed endpoints cannot start a new transition.
+}
