index 0000000..f8bc358
--- /dev/null
+++ b/protocol/wireguard/recovery.go
@@ -0,0 +1,36 @@
+package wireguard
+
+import (
+	"context"
+	"math/rand/v2"
+	"time"
+)
+
+func recoveryDelay(attempt int) time.Duration {
+	if attempt > 6 {
+		attempt = 6
+	}
+	return min(time.Minute, time.Second<<attempt) + time.Duration(rand.IntN(1000))*time.Millisecond
+}
+
+// Returns on success or lifetime cancellation, never because of a transient
+// network failure. No ticker/goroutine survives the endpoint lifetime.
+func recoverEndpoint(ctx context.Context, attempt func() error, failed func(int, error)) {
+	for n := 1; ; n++ {
+		if ctx.Err() != nil {
+			return
+		}
+		err := attempt()
+		if err == nil || ctx.Err() != nil {
+			return
+		}
+		failed(n, err)
+		timer := time.NewTimer(recoveryDelay(n))
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+	}
+}
